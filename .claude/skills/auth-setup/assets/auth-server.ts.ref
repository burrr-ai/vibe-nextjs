// ============================================================
// 레퍼런스: src/server/auth/{service}.ts
// 서비스별로 이 파일을 참고하여 생성한다.
// ============================================================
// 치환 대상:
//   {service}  → app, admin, supplier 등
//   {Service}  → App, Admin, Supplier 등 (PascalCase)
//   {SERVICE}  → APP, ADMIN, SUPPLIER 등 (UPPER_SNAKE)
//   {basePath} → "/{service}/api/auth"
// ============================================================

import 'server-only'

import { betterAuth, type BetterAuthOptions } from "better-auth"
import { drizzleAdapter } from "better-auth/adapters/drizzle"
import { getDb } from "@/server/db"
import * as schema from "@/server/db/schema"
import { config } from "@/server/config"

let authInstance: ReturnType<typeof betterAuth> | null = null

async function createAuth() {
  const db = await getDb()

  const authOptions: BetterAuthOptions = {
    secret: config.{SERVICE}_AUTH_SECRET,
    basePath: "{basePath}",
    database: drizzleAdapter(db, {
      provider: "sqlite",
      schema,
    }),
    emailAndPassword: {
      enabled: true,
    },
    account: {
      skipStateCookieCheck: true,
    },
    advanced: {
      cookiePrefix: "{service}",
      useSecureCookies: true,
      defaultCookieAttributes: {
        sameSite: "None",
      },
    },
    trustedOrigins: ["*"],
  }

  return betterAuth(authOptions)
}

export const get{Service}Auth = async () => {
  if (!authInstance) {
    authInstance = await createAuth()
  }
  return authInstance
}

export const get{Service}ServerSession = async () => {
  const auth = await get{Service}Auth()
  return auth.api.getSession({
    headers: await import('next/headers').then(m => m.headers()),
  })
}
