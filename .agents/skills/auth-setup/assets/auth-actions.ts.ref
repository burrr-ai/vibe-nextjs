// ============================================================
// Reference: services/{service}/state/user/actions/auth.ts
// Use this when replacing an existing mock with real auth.
// ============================================================
// Placeholders to substitute:
//   {service} → app, admin, etc.
//   {homePath} → path to redirect to after successful sign-in (app: '/', admin: '/admin')
//   {loginPath} → path to redirect to after sign-out (app: '/login', admin: '/admin/login')
//   auth client import: '@/lib/auth-client/{service}'
//   The useUser hook name differs per service (useUser, useAdminUser, etc.)
// ============================================================

import { action, silent } from "comwit"
import type { User, UserActions } from "../types"
import { user } from "../model"
import { {service}Auth } from "@/lib/auth-client/{service}"

type UserAuthActions = Pick<UserActions, "init" | "signIn" | "signUp" | "signOut">

export const userAuthActions = action<UserAuthActions>(({ state }) => {
  class UserAuthActions {
    private model = state(user)

    init(user?: User | null | undefined): void {
      silent(() => {
        this.model.me = user
        this.model.isLoading = false
      })
    }

    async signIn({
      email,
      password,
    }: {
      email: string
      password: string
    }): Promise<void> {
      this.model.isLoading = true

      try {
        const { error } = await {service}Auth.signIn.email({
          email,
          password,
        })

        if (error) {
          throw new Error(error.message)
        }

        // Session cookie is set — navigate to the service home so the server re-fetches the user
        window.location.href = '{homePath}'
      } finally {
        this.model.isLoading = false
      }
    }

    async signUp({
      email,
      name,
      password,
    }: {
      email: string
      name: string
      password: string
    }): Promise<void> {
      this.model.isLoading = true

      try {
        const { error } = await {service}Auth.signUp.email({
          email,
          name,
          password,
        })

        if (error) {
          throw new Error(error.message)
        }

        window.location.href = '{homePath}'
      } finally {
        this.model.isLoading = false
      }
    }

    async signOut(): Promise<void> {
      this.model.isLoading = true

      try {
        await {service}Auth.signOut()
        this.model.me = null
        window.location.href = '{loginPath}'
      } finally {
        this.model.isLoading = false
      }
    }
  }

  return new UserAuthActions()
})
